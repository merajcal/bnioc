{
  "name": "bnioc",
  "version": "1.0.0",
  "description": "A modern, responsive React Progressive Web Application (PWA) for Bengaluru Nex-Gen Institute of Cricket, featuring comprehensive cricket training programs, expert coaching profiles, and seamless user experience.",
  "main": "src/index.js",
  "proxy": "http://localhost:4000",
  "scripts": {
    "start": "react-scripts start",
    "server": "node server/index.js",
    "create-admin": "node server/create-admin.js",
    "dev:full": "concurrently \"PORT=3000 npm start\" \"API_PORT=4000 npm run server\"",
    "build": "npm run generate-gallery && react-scripts build",
    "build-prod": "REACT_APP_API_URL=https://bnioc-api-prod.onrender.com/api npm run build",
    "build:prod": "npm run generate-gallery && react-scripts build && npm run zip:build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "rename-gallery": "node scripts/rename-gallery-images.js",
    "generate-gallery": "node scripts/generate-gallery.js",
    "zip:build": "node scripts/create-deployment-zip.js"
  },
  "keywords": [
    "cricket",
    "academy",
    "training",
    "react",
    "pwa"
  ],
  "dependencies": {
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "ws": "^8.18.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}

{
  "name": "bnioc",
  "version": "1.0.0",
  "description": "A modern, responsive React Progressive Web Application (PWA) for Bengaluru Nex-Gen Institute of Cricket, featuring comprehensive cricket training programs, expert coaching profiles, and seamless user experience.",
  "main": "src/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "npm run generate-gallery && react-scripts build",
    "build:prod": "npm run generate-gallery && react-scripts build && npm run zip:build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "rename-gallery": "node scripts/rename-gallery-images.js",
    "generate-gallery": "node scripts/generate-gallery.js",
    "zip:build": "node scripts/create-deployment-zip.js"
  },
  "keywords": [
    "cricket",
    "academy",
    "training",
    "react",
    "pwa"
  ],
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
